{
  "manifest_version": 3,
  "name": "Antagning.se Course Timeline",
  "version": "1.2.0",
  "description": "Unofficial course planner for Antagning.se. See selected courses, overlapping weeks, and estimated study load.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://antagning.se/*", "https://*.antagning.se/*"],
      "run_at": "document_idle",
      "css": ["timeline.css"],
      "js": ["timeline.js"]
    }
  ]
}
